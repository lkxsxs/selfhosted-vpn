# /root/vpn-sub/sub.env
# 订阅服务环境变量（chmod 600，不要提交到 Git）

# 订阅 URL 里的随机 token（32 位十六进制）
SUB_TOKEN=<RANDOM_32_HEX>

# 下发的 Clash 配置文件
SUB_FILE=/root/vpn-sub/config.yaml

# 监听端口
SUB_PORT=80

# 套餐总量（字节）与到期时间（Unix 时间戳）
SUB_TOTAL_BYTES=3298534883328
SUB_EXPIRE_TS=1825804800

# 流量统计（优先级：vnstat > Xray stats > Hysteria2 trafficStats）
VNSTAT_IF=eth0

# 如果不用 vnstat，可启用下面两项
# HY2_STATS_URL=http://127.0.0.1:9999/traffic
# HY2_STATS_SECRET=<HY2_STATS_SECRET>

# 可选：订阅页地址
PROFILE_WEB_PAGE_URL=https://example.com
